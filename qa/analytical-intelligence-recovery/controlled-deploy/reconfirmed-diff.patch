+// Offline regeneration of the SAME four delivery-1 controls. Run from repository root.
+import { mkdir, readFile, writeFile } from 'node:fs/promises';
+import { resolve } from 'node:path';
+import { createHash } from 'node:crypto';
+import { execFileSync } from 'node:child_process';
+import assert from 'node:assert/strict';
+import { createServer } from 'vite';
+import { createCanvas, Image, DOMMatrix, ImageData, Path2D } from '@napi-rs/canvas';
+import { reportIntegrityFixtures } from './report-integrity-fixtures.mjs';
+
+const output = resolve(process.env.QA_OUTPUT || 'qa/analytical-intelligence-recovery');
+const sha256 = bytes => createHash('sha256').update(bytes).digest('hex');
+const names = ['A-4724-L3-blocker', 'B-Honolulu-L3-rent-fixture', 'C-profile-L2', 'C-no-profile-L2'];
+const before = Object.fromEntries(await Promise.all(names.map(async name => {
+  const path = resolve(output, `${name}.pdf`);
+  return [name, { path, sha256: await readFile(path).then(sha256).catch(error => { if (error.code === 'ENOENT') return null; throw error; }) }];
+})));
+await mkdir(output, { recursive: true });
+let networkAttempts = 0, mockProviderCalls = 0;
+globalThis.fetch = async () => { networkAttempts++; throw Error('LIVE_NETWORK_FORBIDDEN'); };
+Object.assign(globalThis, { DOMMatrix, ImageData, Path2D, Image, document: { createElement(tag) {
+  if (tag === 'canvas') return createCanvas(1, 1); if (tag === 'img') return new Image(); throw Error('UNSUPPORTED_QA_ELEMENT');
+} } });
+const server = await createServer({ configFile: false, server: { middlewareMode: true, watch: null }, appType: 'custom', optimizeDeps: { noDiscovery: true, include: [] } });
+const metadata = { mode: 'QA_SIMULATION_ONLY', simulatedDate: '2026-10-18T00:00:00Z', startedAt: new Date().toISOString(),
+  codeCommit: execFileSync('git', ['rev-parse', 'HEAD'], { encoding: 'utf8' }).trim(), worktree: process.cwd(), output,
+  scriptSha256: sha256(await readFile(new URL(import.meta.url))), before, networkAttempts: 0, cases: [] };
+assert.equal(execFileSync('git', ['diff', '--name-only', 'HEAD', '--', 'src', 'scripts', 'supabase'], { encoding: 'utf8' }).trim(), '', 'Generation code must match the recorded commit');
+try {
+  const load = path => server.ssrLoadModule(path);
+  const { orchestrateDealInsightContext } = await load('/supabase/functions/_shared/maxxis/dealInsightContext.ts');
+  const { calculatePropertyMatch } = await load('/supabase/functions/_shared/maxxis/calculatePropertyMatch.ts');
+  const { calculateDealMetrics } = await load('/supabase/functions/_shared/maxxis/dealMetrics.ts');
+  const { projectMaxxisDealIntelligenceResponse: l3 } = await load('/src/features/maxxis/intelligence/maxxisDealIntelligenceReport.js');
+  const { projectMaxxisAnalysisResponse: l2 } = await load('/src/features/maxxis/intelligence/maxxisAnalysisReport.js');
+  const { renderMaxxisReportPdf } = await load('/src/features/maxxis/export/maxxisReportPdf.js');
+  const { resolveReportExportEntitlement } = await load('/src/features/maxxis/export/reportExportEntitlement.js');
+  const { buildStrictReportViewModel } = await load('/src/features/maxxis/export/reportIntegrityViewModel.ts');
+  const { MarketRentService } = await load('/supabase/functions/_shared/property-data/marketRentService.ts');
+  const { InMemorySupplementalEvidenceCache } = await load('/supabase/functions/_shared/property-data/supplementalEvidenceCache.ts');
+  const { resolveRentAvmSubjectAttributes } = await load('/supabase/functions/_shared/property-data/rentAvmSubject.ts');
+  const { buildFinancialEvidenceFromAuthorizedContext } = await load('/supabase/functions/_shared/maxxis/financialEvidenceContext.ts');
+  const { getDocument } = await import('pdfjs-dist/legacy/build/pdf.mjs');
+  const controls = reportIntegrityFixtures();
+  // Previous harness overwrote only `lot` with 7013, leaving lotSizeSqft=5000.
+  // This synthetic lot has ONE source: 5000 sqft. 1 acre = 43560 sqft.
+  // Four-decimal acre display tolerance: 0.00005 ac (=2.178 sqft), plus 1e-9 floating error.
+  const notes = 'QA / SIMULAÇÃO — dados e perfil sintéticos; nenhuma sessão autenticada real ou consulta RentCast/GIS. Datas de 18/10/2026 são metadata de teste, não consultas. Execução histórica de vendas não registrada.';
+  const property = { ...controls.find(c => c.id === 'LOW_EVIDENCE_SELL').input.property,
+    baths: 1, sqft: 806, lot: 5000, lotSizeSqft: 5000, lotSizeAcres: 5000 / 43560,
+    owner: { name: 'QA Publisher' }, propertyUserNotes: notes, localizedPropertyUserNotes: null };
+  assert.ok(Math.abs(property.lotSizeSqft - Number(property.lotSizeAcres.toFixed(4)) * 43560) <= 2.178 + 1e-9);
+  const profile = { status: 'complete', targetMarkets: ['AR'], priceRange: 'lt_100k', propertyTypes: ['Single Family'], strategies: ['Fix & Flip'] };
+  async function raw(p, basis = null, extra = {}) {
+    const result = await orchestrateDealInsightContext({ propertyId: p.id,
+      loadPropertyDetails: async () => ({ found: true, property: p, missingFields: [], metrics: calculateDealMetrics(p), analysis: { positiveSignals: [], attentionPoints: [], missingInformation: [], limitations: [] } }),
+      loadInvestmentProfile: async () => ({ profile: basis, exists: !!basis, complete: !!basis }), calculateMatch: calculatePropertyMatch,
+      loadPropertyEvidence: async () => ({ state: 'not_loaded', propertyId: p.id, entitlementState: 'authorized', cacheState: 'miss' }) });
+    return { data: { ...result, intelligenceSnapshot: { propertyFacts: p, investmentProfile: result.investmentProfile, matchScore: result.match, ...extra } } };
+  }
+  const rental = controls.find(c => c.id === 'RENTAL_MARKET_RICH').input;
+  const rentEvidence = { ...rental.dealIntelligence.valuationIntelligence.rentalEvidence.rentEstimate, retrievedAt: metadata.simulatedDate };
+  const now = () => new Date(metadata.simulatedDate);
+  const service = new MarketRentService({ cache: new InMemorySupplementalEvidenceCache(now), now, enabled: true,
+    provider: { getRentEstimate: async input => { mockProviderCalls++; return { ...rentEvidence, queryFingerprint: input.queryFingerprint }; } },
+    hasEntitlement: async () => true, resolveSubject: async () => resolveRentAvmSubjectAttributes({ property: rental.property }) });
+  const acquired = await service.get({ propertyId: rental.property.id, userId: 'SYNTHETIC_ACTOR', acquire: true });
+  const cached = await service.get({ propertyId: rental.property.id, userId: 'SYNTHETIC_ACTOR', acquire: true });
+  assert.equal(cached.cacheHit, true); assert.equal(mockProviderCalls, 1);
+  const financialEvidence = buildFinancialEvidenceFromAuthorizedContext({ propertyId: rental.property.id, cachedRent: { evidence: acquired.evidence, freshness: acquired.freshness } });
+  const valid = await raw(property, profile);
+  assert.deepEqual([valid.data.match.score, valid.data.match.evaluatedCriteria, valid.data.match.earnedPoints, valid.data.match.evaluatedWeight], [100, 3, 85, 85]);
+  const cases = [
+    ['A-4724-L3-blocker', l3(await raw(property, null, { marketRent: { propertyId: property.id, state: 'SUBJECT_UNAVAILABLE', reason: 'HISTORICAL_CAUSE_NOT_RECORDED' } }))],
+    ['B-Honolulu-L3-rent-fixture', l3(await raw({ ...rental.property, propertyUserNotes: notes, localizedPropertyUserNotes: null }, null, { marketRent: cached, financialEvidence }))],
+    ['C-profile-L2', l2(valid)], ['C-no-profile-L2', l2(await raw(property, null))],
+  ];
+  for (const [name, projected] of cases) {
+    const schema = projected.data.maxxisReport, vm = buildStrictReportViewModel({ schema, language: 'pt' });
+    const result = await renderMaxxisReportPdf({ schema, language: 'pt', generatedAt: metadata.simulatedDate, exportEntitlement: resolveReportExportEntitlement({ plan: 'enterprise', reportType: schema.reportType, channel: 'PDF' }) });
+    assert.equal(result.state, 'RENDERED', JSON.stringify(result.validation));
+    const finalPath = resolve(output, `${name}.pdf`);
+    if (before[name].sha256) {
+      const previous = await getDocument({ data: new Uint8Array(await readFile(finalPath)), useSystemFonts: true }).promise;
+      let previousText = '';
+      for (let n = 1; n <= previous.numPages; n++) previousText += ` ${(await (await previous.getPage(n)).getTextContent()).items.map(i => i.str).join(' ')}`;
+      before[name].extractedTextSha256 = sha256(previousText);
+      before[name].checks = {
+        qa: /QA \/ SIMULAÇÃO/.test(previousText),
+        area: name.startsWith('B-') ? 'NOT_APPLICABLE' : /5\.000\s+sqft/.test(previousText) && /0,1148\s+ac/.test(previousText),
+        soldWording: !/Vendas identificadas|Identified sales|Ventas identificadas/i.test(previousText),
+        coverage: name !== 'C-profile-L2' ? 'NOT_APPLICABLE' : /3\/4 critérios avaliados/.test(previousText) && /Não avaliados: Estratégia/.test(previousText),
+        noRealSessionClaim: !/Perfil do usuário autenticado/i.test(previousText),
+      };
+      previous.cleanup();
+    }
+    await writeFile(finalPath, result.document.binary);
+    const finalBytes = await readFile(finalPath);
+    assert.equal(sha256(finalBytes), sha256(result.document.binary));
+    // Validate the FINAL FILE read from disk, not only the renderer return or ViewModel.
+    const pdf = await getDocument({ data: new Uint8Array(finalBytes), useSystemFonts: true }).promise;
+    let text = ''; const pages = [];
+    for (let n = 1; n <= pdf.numPages; n++) {
+      const page = await pdf.getPage(n), content = (await page.getTextContent()).items.map(i => i.str).join(' ');
+      text += ` ${content}`; pages.push({ page: n, text: content });
+    }
+    assert.match(text, /QA \/ SIMULAÇÃO/); assert.doesNotMatch(text, /Perfil do usuário autenticado|Vendas identificadas ainda não sustentam ARV/i);
+    if (!name.startsWith('B-')) { assert.match(pages[0].text, /5\.000\s+sqft/); assert.match(pages[0].text, /0,1148\s+ac/); }
+    if (name.startsWith('A-') || name.startsWith('C-')) assert.doesNotMatch(text, /Vendas identificadas|Identified sales|Ventas identificadas/i);
+    if (name.startsWith('A-')) { assert.match(text, /execução não comprovada/); assert.match(text, /Consulte e verifique vendas fechadas/); }
+    if (!name.startsWith('B-')) { assert.equal(vm.values.lotSizeSqft.numericValue, 5000); assert.ok(Math.abs(vm.values.lotSizeAcres.numericValue - 5000 / 43560) <= .00005); }
+    if (name === 'C-profile-L2') { assert.match(text, /3\/4 critérios avaliados/); assert.match(text, /Não avaliados: Estratégia/); assert.match(text, /100%/); assert.match(text, /dados e perfil sintéticos/); assert.match(text, /nenhuma sessão autenticada real/); }
+    else { assert.ok(!vm.sections.find(s => s.id === 'profile-fit')); assert.ok(!vm.sections.find(s => s.id === 'profile-criteria')); }
+    if (name.startsWith('B-')) { const rent = vm.sections.find(s => s.id === 'market-rent'); assert.ok(rent.range); assert.equal(rent.table.rows.length, 5); assert.equal(rent.map.points.filter(p => p.id !== 'subject').length, 5); for (const row of rent.table.rows) assert.ok(text.includes(row[1])); }
+    metadata.cases.push({ name, finalPath, sha256: sha256(finalBytes), beforeSha256: before[name].sha256,
+      bytesChanged: before[name].sha256 !== sha256(finalBytes), extractedTextSha256: sha256(text),
+      pages: pdf.numPages, result: 'PASS_FINAL_FILE', profileOrigin: name === 'C-profile-L2' ? 'SYNTHETIC_QA_LOADER' : 'NO_PROFILE', pagesText: pages });
+    pdf.cleanup();
+  }
+  assert.equal(networkAttempts, 0);
+  await writeFile(resolve(output, 'acceptance-verification.json'), JSON.stringify({ ...metadata, networkAttempts, mockProviderCalls, cacheReused: cached.cacheHit }, null, 2));
+  console.log(JSON.stringify({ result: 'PASS', controls: metadata.cases.map(({ pagesText, ...item }) => item), networkAttempts, mockProviderCalls }));
+} finally { await server.close(); }
