index 0000000..51ea5bd
--- /dev/null
+++ b/src/features/maxxis/intelligence/reportProfileProjection.js
@@ -0,0 +1,11 @@
+// Report payload boundary: never copy the complete private Investment Profile.
+export function reportProfileProjection(profile) {
+  if (!profile || typeof profile !== 'object' || Array.isArray(profile)) return null;
+  const texts = value => Object.freeze(Array.isArray(value) ? value.filter(item => typeof item === 'string').map(item => item.trim()).filter(Boolean) : []);
+  return Object.freeze({
+    targetMarkets: texts(profile.targetMarkets),
+    priceRange: typeof profile.priceRange === 'string' ? profile.priceRange : null,
+    propertyTypes: texts(profile.propertyTypes),
+    strategies: texts(profile.strategies),
+  });
+}
