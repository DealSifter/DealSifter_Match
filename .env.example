# =============================================================================
# MODELO — copie para .env.local e preencha com valores reais.
# NUNCA coloque chaves reais neste arquivo (.env.example vai para o GitHub).
# =============================================================================

# ── Frontend (Vercel + npm run dev) — prefixo VITE_ obrigatório ─────────────
VITE_SUPABASE_URL=https://SEU_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=sua_chave_anon_publica_supabase

VITE_APP_URL=https://seu-app.vercel.app
VITE_USE_POLLING=true
VITE_SENTRY_DSN=https://exemplo@sentry.io/projeto
VITE_SENTRY_TRACES_SAMPLE_RATE=0.05
VITE_SENTRY_OPERATION_SAMPLE_RATE=0.10
VITE_SENTRY_WEB_VITALS_SAMPLE_RATE=0.10
VITE_APP_ENVIRONMENT=development
# Gerado automaticamente por Vercel/GitHub em deploys; não hardcode em produção.
VITE_APP_RELEASE=local

# Somente build/CI — nunca expor com prefixo VITE_.
SENTRY_AUTH_TOKEN=sntrys_seu_token_de_upload
SENTRY_ORG=sua_org
SENTRY_PROJECT=seu_projeto

VITE_STRIPE_PUBLISHABLE_KEY=pk_live_ou_pk_test_sua_chave_publica_stripe

# IDs de preço Stripe (formato: price_xxxxxxxx — copie do Dashboard Stripe)
VITE_STRIPE_PRICE_P5=price_xxxxxxxx
VITE_STRIPE_PRICE_P15=price_xxxxxxxx
VITE_STRIPE_PRICE_P40=price_xxxxxxxx
VITE_STRIPE_PRICE_P100=price_xxxxxxxx
VITE_STRIPE_PRICE_PLAN_PRO=price_xxxxxxxx
VITE_STRIPE_PRICE_PLAN_ENTERPRISE=price_xxxxxxxx
VITE_STRIPE_PRICE_PLAN_PRO_YEAR=price_xxxxxxxx
VITE_STRIPE_PRICE_PLAN_ENTERPRISE_YEAR=price_xxxxxxxx

# ── Somente Supabase Edge Functions (NÃO na Vercel do frontend) ─────────────
SUPABASE_URL=https://SEU_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sua_service_role_secret
APP_URL=https://seu-app.vercel.app
# Opcional: origens adicionais exatas, separadas por vírgula (preview/staging)
APP_ALLOWED_ORIGINS=https://seu-app.vercel.app
MAXXIS_ALLOWED_ORIGINS=https://seu-app.vercel.app

STRIPE_SECRET_KEY=sk_live_ou_sk_test_sua_chave_secreta_stripe
STRIPE_WEBHOOK_SECRET=whsec_sua_chave_webhook
# Alias opcional:
# STRIPE_WEBHOOK_SIGNING_SECRET=whsec_sua_chave_webhook
