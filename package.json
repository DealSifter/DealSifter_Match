{
  "name": "DealSifter_Match",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.17.0 <23"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5174 --strictPort",
    "dev:poll": "cross-env CHOKIDAR_USEPOLLING=true vite --host 0.0.0.0 --port 5174 --strictPort",
    "build": "node scripts/check-build-env.mjs && vite build",
    "test": "vitest run",
    "test:e2e": "playwright test --config=playwright.config.js",
    "test:e2e:headed": "playwright test --config=playwright.config.js --headed",
    "test:e2e:ci": "playwright test --config=playwright.config.js",
    "test:e2e:integration": "playwright test --config=playwright.integration.config.js",
    "dev:e2e": "vite --host 127.0.0.1 --port 4180 --strictPort",
    "dev:e2e:integration": "vite --host 127.0.0.1 --port 4181 --strictPort",
    "audit:functions": "node scripts/audit-edge-function-parity.mjs",
    "audit:functions:remote": "node scripts/audit-edge-function-parity.mjs --remote",
    "audit:secrets:remote": "node scripts/audit-edge-function-secrets.mjs",
    "audit:hosting": "node scripts/audit-vercel-security.mjs",
    "audit:bundle": "node scripts/audit-bundle-size.mjs",
    "audit:observability": "node scripts/audit-observability.mjs",
    "observability:smoke": "node scripts/observability-smoke.mjs",
    "audit:env": "node scripts/check-build-env.mjs --strict",
    "audit:deps": "npm audit --audit-level=low",
    "quality:fast": "npm run audit:functions && npm run audit:hosting && npm run audit:env && npm run audit:observability && npm run lint && npm run test && npm run audit:deps",
    "quality": "npm run quality:fast && npm run build && npm run audit:bundle",
    "prepare": "husky",
    "lint": "eslint src/ --max-warnings=0",
    "preview": "vite preview --host 0.0.0.0 --port 4173 --strictPort"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@sentry/react": "^10.63.0",
    "@supabase/supabase-js": "^2.103.0",
    "@vercel/speed-insights": "^2.0.0",
    "framer-motion": "^12.35.1",
    "jspdf": "^4.2.1",
    "leaflet": "^1.9.4",
    "localforage": "^1.10.0",
    "lucide-react": "^0.577.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-leaflet": "^5.0.0",
    "supercluster": "^8.0.1",
    "web-vitals": "^6.1.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.3",
    "@playwright/test": "^1.62.1",
    "@sentry/vite-plugin": "^5.4.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-legacy": "^7.2.1",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "9.39.3",
    "eslint-formatter-pretty": "^7.0.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "terser": "^5.49.0",
    "vite": "^7.3.1",
    "vitest": "^4.1.10"
  },
  "optionalDependencies": {
    "cross-env": "^7.0.3"
  },
  "lint-staged": {
    "**/*.{js,jsx,ts,tsx}": [
      "eslint --fix"
    ]
  }
}
